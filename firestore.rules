rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow create: if request.resource.data.wish is string
        && request.resource.data.wish.size() > 0
        && request.resource.data.wish.size() <= 500
        && request.resource.data.sender is string
        && request.resource.data.sender.size() <= 40;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
